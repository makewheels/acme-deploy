# ===== 必填 =====
# 要签发证书的域名
CERT_DOMAIN=bucket-static.example.com
# Let's Encrypt 账户邮箱
LE_EMAIL=you@example.com
# 阿里云凭证（本地测试用；FC 上由 RAM 角色自动注入，无需配置）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# ===== 插件选择 =====
# DNS 提供商（已实现：alidns）
# DNS_PROVIDER=alidns
# 部署目标（已实现：oss_cname，把证书绑定到 OSS 自定义域名）
# DEPLOY_TARGET=oss_cname

# ===== 目标插件配置 =====
# oss_cname：目标 bucket
OSS_BUCKET=your-bucket
# oss_cname：bucket 所在 region，不填则自动探测
# OSS_REGION=cn-beijing

# ===== 可选 =====
# STS 临时凭证 token（一般不用手动配）
# ALIBABA_CLOUD_SECURITY_TOKEN=
# 使用 LE staging 环境测试（staging 模式只签发不部署，避免污染正式证书）
# LE_STAGING=1
# 证书剩余天数低于该值才续期
# RENEW_BEFORE_DAYS=30
# 本地状态目录（账户密钥/域名密钥/证书）
# STATE_DIR=./state
# 把状态持久化到 OSS（云函数等无状态环境使用）
# STATE_OSS_URI=oss://your-bucket/.acme-deploy-state/
